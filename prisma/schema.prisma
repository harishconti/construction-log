// prisma/schema.prisma
//
// Construction Ledger data model.
// Design notes:
//  - Actual budget spend is NEVER stored; it is derived from Transaction rows.
//  - Attachments carry a projectId so every file is scoped to its project at the
//    DB level (in addition to the generic parentType/parentId link).
//  - Budget revisions are append-only history.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id // Neon Auth user id (UUID) — mirrored locally for FK integrity
  name         String
  email        String   @unique
  passwordHash String? // legacy field; credentials are managed by Neon Auth
  createdAt    DateTime @default(now())

  memberships    ProjectMember[]
  transactions   Transaction[]
  diaryEntries   DiaryEntry[]
  auditLogs      AuditLog[]
  budgetsCreated Budget[]
  uploads        Attachment[]
  projectsOwned  Project[]       @relation("ProjectCreator")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  startDate   DateTime
  status      String   @default("active") // active | paused | completed
  createdBy   String
  createdAt   DateTime @default(now())

  creator      User            @relation("ProjectCreator", fields: [createdBy], references: [id])
  members      ProjectMember[]
  categories   Category[]
  transactions Transaction[]
  diaryEntries DiaryEntry[]
  budgets      Budget[]
  attachments  Attachment[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String // 'admin' | 'editor' | 'viewer'
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Category {
  id        String  @id @default(cuid())
  projectId String
  name      String // e.g. "Cement", "Labour", "GST", "Electricity"
  type      String // 'material' | 'labour' | 'tax' | 'utility' | 'misc'
  isActive  Boolean @default(true)

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([projectId, name])
}

model Transaction {
  id          String    @id @default(cuid())
  projectId   String
  categoryId  String
  occurredAt  DateTime
  amount      Decimal   @db.Decimal(12, 2)
  gstAmount   Decimal   @default(0) @db.Decimal(12, 2)
  vendor      String?
  paymentMode String // 'cash' | 'upi' | 'bank' | 'card' | 'credit'
  description String?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // soft delete

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category      Category @relation(fields: [categoryId], references: [id])
  createdByUser User     @relation(fields: [createdBy], references: [id])

  @@index([projectId, occurredAt])
  @@index([projectId, categoryId])
  @@index([createdBy])
}

model DiaryEntry {
  id        String   @id @default(cuid())
  projectId String
  entryDate DateTime
  title     String
  body      String   @db.Text
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdByUser User    @relation(fields: [createdBy], references: [id])

  @@index([projectId, entryDate])
  @@index([createdBy])
}

model Attachment {
  id         String   @id @default(cuid())
  projectId  String
  parentType String // 'transaction' | 'diary_entry'
  parentId   String
  fileKey    String // R2 object key
  fileUrl    String // public or presigned URL
  mimeType   String
  uploadedBy String
  uploadedAt DateTime @default(now())

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploadedBy], references: [id])

  @@index([parentType, parentId])
  @@index([projectId])
}

model Budget {
  id            String   @id @default(cuid())
  projectId     String
  categoryId    String
  periodType    String // 'week' | 'month'
  periodStart   DateTime // Monday for week, 1st for month
  plannedAmount Decimal  @db.Decimal(12, 2)
  note          String?
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category  Category         @relation(fields: [categoryId], references: [id])
  creator   User             @relation(fields: [createdBy], references: [id])
  revisions BudgetRevision[]

  @@unique([projectId, categoryId, periodType, periodStart])
  @@index([projectId, periodType, periodStart])
}

model BudgetRevision {
  id        String   @id @default(cuid())
  budgetId  String
  oldAmount Decimal  @db.Decimal(12, 2)
  newAmount Decimal  @db.Decimal(12, 2)
  reason    String?
  changedBy String
  changedAt DateTime @default(now())

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId, changedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  entity    String // 'transaction' | 'diary_entry' | 'budget' | 'project' | 'member' | 'category'
  entityId  String
  action    String // 'create' | 'update' | 'delete' | 'restore' | 'role_change'
  actorId   String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId, createdAt])
}
