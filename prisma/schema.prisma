// prisma/schema.prisma
//
// Construction Ledger data model (target design — see docs/02-DATA-MODEL.md).
// Design notes:
//  - Auth identity is Neon Auth; User.id mirrors the Neon Auth user id. No passwords stored.
//  - Actual budget spend is NEVER stored; it is derived from Transaction rows.
//  - Attachments are private and server-keyed; attached rows reference exactly one parent
//    (transaction XOR diary_entry), enforced by a CHECK constraint in a migration.
//  - `version` columns provide optimistic locking. `IdempotencyKey` makes create/finalize retry-safe.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id // Neon Auth user id (mirrored locally for FK integrity)
  name      String
  email     String   @unique
  createdAt DateTime @default(now())

  memberships    ProjectMember[]
  transactions   Transaction[]
  diaryEntries   DiaryEntry[]
  auditLogs      AuditLog[]
  budgetsCreated Budget[]
  uploads        Attachment[]
  projectsOwned  Project[]        @relation("ProjectCreator")
  invitationsSent Invitation[]    @relation("InvitationInviter")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  startDate   DateTime
  status      String   @default("active") // active | paused | completed
  version     Int      @default(0)
  createdBy   String
  createdAt   DateTime @default(now())

  creator      User            @relation("ProjectCreator", fields: [createdBy], references: [id])
  members      ProjectMember[]
  invitations  Invitation[]
  categories   Category[]
  transactions Transaction[]
  diaryEntries DiaryEntry[]
  budgets      Budget[]
  attachments  Attachment[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String // 'admin' | 'editor' | 'viewer'
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

/// Pending membership for an email that has not signed up yet. Claimed automatically on first sign-in.
model Invitation {
  id        String   @id @default(cuid())
  projectId String
  email     String
  role      String // 'admin' | 'editor' | 'viewer'
  invitedBy String
  expiresAt DateTime
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inviter User    @relation("InvitationInviter", fields: [invitedBy], references: [id])

  @@unique([projectId, email])
  @@index([email])
}

model Category {
  id        String  @id @default(cuid())
  projectId String
  name      String // e.g. "Cement", "Labour", "GST", "Electricity"
  type      String // 'material' | 'labour' | 'tax' | 'utility' | 'misc'
  isActive  Boolean @default(true)

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([projectId, name])
}

model Transaction {
  id          String    @id @default(cuid())
  projectId   String
  categoryId  String
  occurredAt  DateTime
  amount      Decimal   @db.Decimal(12, 2) // GST-inclusive total
  gstAmount   Decimal   @default(0) @db.Decimal(12, 2) // tax component already inside `amount`
  vendor      String?
  paymentMode String // 'cash' | 'upi' | 'bank' | 'card' | 'credit'
  description String?
  version     Int       @default(0)
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // soft delete

  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category      Category     @relation(fields: [categoryId], references: [id])
  createdByUser User         @relation(fields: [createdBy], references: [id])
  attachments   Attachment[]

  @@index([projectId, occurredAt])
  @@index([projectId, categoryId])
  @@index([createdBy])
}

model DiaryEntry {
  id        String   @id @default(cuid())
  projectId String
  entryDate DateTime
  title     String
  body      String   @db.Text
  version   Int      @default(0)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdByUser User         @relation(fields: [createdBy], references: [id])
  attachments   Attachment[]

  @@index([projectId, entryDate])
  @@index([createdBy])
}

model Attachment {
  id            String   @id @default(cuid())
  projectId     String
  transactionId String?
  diaryEntryId  String?
  status        String   @default("pending") // 'pending' | 'ready'
  fileKey       String // server-generated R2 object key; clients never supply this
  originalName  String? // client filename, sanitized, used only for the download header
  mimeType      String
  size          Int? // bytes, verified at finalize
  checksum      String? // optional content hash
  uploadedBy    String
  uploadedAt    DateTime @default(now())

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  diaryEntry  DiaryEntry?  @relation(fields: [diaryEntryId], references: [id], onDelete: Cascade)
  uploader    User         @relation(fields: [uploadedBy], references: [id])

  @@index([projectId])
  @@index([transactionId])
  @@index([diaryEntryId])
  @@index([status])
}

model Budget {
  id            String   @id @default(cuid())
  projectId     String
  categoryId    String
  periodType    String // 'week' | 'month'
  periodStart   DateTime // Monday for week, 1st for month (Asia/Kolkata boundary)
  plannedAmount Decimal  @db.Decimal(12, 2)
  note          String?
  version       Int      @default(0)
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category  Category         @relation(fields: [categoryId], references: [id])
  creator   User             @relation(fields: [createdBy], references: [id])
  revisions BudgetRevision[]

  @@unique([projectId, categoryId, periodType, periodStart])
  @@index([projectId, periodType, periodStart])
}

model BudgetRevision {
  id        String   @id @default(cuid())
  budgetId  String
  oldAmount Decimal  @db.Decimal(12, 2)
  newAmount Decimal  @db.Decimal(12, 2)
  reason    String?
  changedBy String // plain column; no FK relation
  changedAt DateTime @default(now())

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId, changedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  entity    String // 'transaction' | 'diary_entry' | 'budget' | 'project' | 'member' | 'category' | 'attachment'
  entityId  String
  action    String // 'create' | 'update' | 'delete' | 'restore' | 'role_change' | 'finalize'
  actorId   String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId, createdAt])
}

model IdempotencyKey {
  id          String   @id @default(cuid())
  projectId   String
  userId      String
  key         String
  requestHash String
  response    Json?
  createdAt   DateTime @default(now())

  @@unique([projectId, userId, key])
  @@index([createdAt])
}

/// Retry queue for R2 object deletions that failed or were deferred.
model ObjectDeletion {
  id        String   @id @default(cuid())
  projectId String?
  fileKey   String
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}
