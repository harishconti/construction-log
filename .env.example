# ---------------------------------------------------------------------------
# Construction Ledger — environment variables
# Copy to .env (local dev) or .env.production (deploy). NEVER commit real values.
# This file is the single source of truth for variable names.
# ---------------------------------------------------------------------------

# Database — Neon Postgres
# DATABASE_URL: POOLED connection string (runtime traffic)
# DIRECT_URL:   DIRECT (unpooled) connection string (migrations)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxx.<region>.aws.neon.tech/neondb?sslmode=require

# Neon Auth (Managed Better Auth) — base URL includes the path
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.<region>.aws.neon.tech/neondb/auth
# Generate with: openssl rand -base64 32  (must be >= 32 chars)
NEON_AUTH_COOKIE_SECRET=replace-with-a-32-char-plus-secret

# Public URL of the app (used for absolute links / PWA)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare R2 (image storage, S3-compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=construction-ledger
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# Only set if the bucket is publicly readable (custom domain or r2.dev)
R2_PUBLIC_URL=

# App runtime
NODE_ENV=development
PORT=3000
